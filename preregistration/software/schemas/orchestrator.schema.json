{
  "title": "POLIS orchestrator output",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_role", "scenario_id", "input_hash", "decisions", "hard_constraint_override", "unresolved_items"],
  "properties": {
    "agent_role": {"type": "string", "enum": ["orchestrator"]},
    "scenario_id": {"type": "string"},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "action", "need_ids", "source_ids", "affected_parameters", "review_trigger", "rationale"],
        "properties": {
          "decision_id": {"type": "string"},
          "action": {"enum": ["retain", "revise", "reject", "phase", "compromise", "equity_prioritise", "unresolved"]},
          "need_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "affected_parameters": {"type": "array", "items": {"type": "string"}},
          "review_trigger": {"type": ["string", "null"]},
          "rationale": {"type": "string"}
        }
      }
    },
    "hard_constraint_override": {"type": "boolean", "enum": [false]},
    "unresolved_items": {"type": "array", "items": {"type": "string"}}
  }
}
