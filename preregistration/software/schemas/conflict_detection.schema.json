{
  "title": "POLIS conflict detection output",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_role", "scenario_id", "input_hash", "conflicts", "unresolved_items"],
  "properties": {
    "agent_role": {"type": "string", "enum": ["conflict_detection"]},
    "scenario_id": {"type": "string"},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflict_id", "conflict_type", "need_ids", "affected_object_or_resource", "evidence_source_ids"],
        "properties": {
          "conflict_id": {"type": "string"},
          "conflict_type": {"enum": ["spatial", "resource", "temporal"]},
          "need_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "affected_object_or_resource": {"type": "string"},
          "evidence_source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "unresolved_items": {"type": "array", "items": {"type": "string"}}
  }
}
